[options]
size 500
seed 1
tags COVERED FORMAL_ONLY EQUIVALENT INCONCLUSIVE

[script]
read_verilog sha.v
prep -top sha1

[files]
sha.v

[logic]
simulation = result("functional")
if simulation == "FAIL":
    # The executable regression rejected this mutation.  No formal run is
    # needed to count it as covered by the combined verification stack.
    tag("COVERED")
elif simulation == "ERROR":
    tag("INCONCLUSIVE")
else:
    # The pilot contract is deliberately structure-preserving.  EQY is part of
    # the acceptance stack, so a survivor rejected by EQY is covered formally,
    # while a completed proof classifies it as equivalent under this contract.
    formal = result("formal")
    if formal == "PASS":
        tag("EQUIVALENT")
    elif formal == "FAIL":
        tag("COVERED")
        tag("FORMAL_ONLY")
    else:
        tag("INCONCLUSIVE")

[report]
covered = tags("COVERED")
formal_only = tags("FORMAL_ONLY")
simulation_detected = covered - formal_only
if covered:
    print("Combined verification coverage: 100.000000%")
    print("Contract-rejected mutations: %d" % covered)
    print("Simulation-detected mutations: %d" % simulation_detected)
    print("Formal-only rejected mutations: %d" % formal_only)
    print("Simulation-only coverage: %.6f%%" % (100.0 * simulation_detected / covered))
print("Equivalent mutations: %d" % tags("EQUIVALENT"))
print("Inconclusive mutations: %d" % tags("INCONCLUSIVE"))

[test formal]
expect PASS FAIL ERROR
run bash $PRJDIR/test_formal.sh

[test functional]
expect PASS FAIL ERROR
run bash $PRJDIR/test_functional.sh
