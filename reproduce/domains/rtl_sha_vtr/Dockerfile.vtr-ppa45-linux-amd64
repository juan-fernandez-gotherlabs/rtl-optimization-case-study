      > /workspace/requirements-ppa45-linux-amd64.lock \
    && echo '33da7b62c7eecbb4b567186848f30278be7f3f59a7282baca54887b6c4fdaab7  /workspace/requirements-ppa45-linux-amd64.lock' | sha256sum -c - \
    && ${WORKSPACE}/.venv/bin/pip install --require-hashes --only-binary=:all: \
      -r /workspace/requirements-ppa45-linux-amd64.lock \
    && ${WORKSPACE}/.venv/bin/pip freeze --all | LC_ALL=C sort > /workspace/pip-manifest.txt \
    && dpkg-query -W -f='${Package}\t${Version}\n' | sort > /workspace/dpkg-manifest.tsv \
    && mkdir -p /workspace/third-party-licenses/debian \
    && cd / \
    && find usr/share/doc -mindepth 2 -maxdepth 2 -type f -name copyright -print0 \
      | tar --null -T - -czf /workspace/third-party-licenses/debian-package-copyrights.tar.gz \
    && cd ${WORKSPACE} \
    && rm -rf /var/lib/apt/lists/*

# Validate the complete recursive source identity after the pinned package set
# has provided Git.  A dirty or partially initialized VTR context is rejected.
RUN test "$(git rev-parse HEAD)" = "${VTR_COMMIT}" \
    && git diff --quiet \
    && test -z "$(git status --porcelain --untracked-files=all -- . \
      ':(exclude).venv' ':(exclude)dpkg-manifest.tsv' ':(exclude)pip-manifest.txt' \
      ':(exclude)requirements-ppa45-linux-amd64.lock' ':(exclude)third-party-licenses')" \
    && git submodule status --recursive | awk '{print $1 " " $2}' > /tmp/submodules.actual \
    && printf '%s\n' \
      'bcfb10e498df3e2ed8f814b3e4b689b9a85608ab libs/EXTERNAL/libcatch2' \
      'fb1d62fcdb1a6c136726e4190b056c4fa22f3074 libs/EXTERNAL/libezgl' \
      '7a49e2c9ad469d314aa7ec07d3e893ecabd7d9dc libs/EXTERNAL/libsdcparse' \
      '599f750c8b6532950d4bb43b2b756700e41dbae9 libs/EXTERNAL/sockpp' \
      '2decf96e915d2b0c26c68c1659665789dfef2633 libs/EXTERNAL/yaml-cpp' \
      '60f126cd00c94892782470192d6c9f7abebe7c05 libs/EXTERNAL/yosys' \
      'e55d316cc9a7f72a84a76eda555aa6ec083c9d0d libs/EXTERNAL/yosys/abc' \
      '4bf61f08697b110d9e3991864650a405b3dd515d libs/EXTERNAL/yosys/libs/cxxopts' \
      '55e3a2ad5b9dcdc8cf86918fb0a110fb6356def8 libs/EXTERNAL/yosys-slang' \
      '553ec11ec06fbe0beebfbb45f9dc3c9eabd83d28 libs/EXTERNAL/yosys-slang/third_party/fmt' \
      'f316723be57953fdeddc26650e6acab46a686be3 libs/EXTERNAL/yosys-slang/third_party/slang' \
      > /tmp/submodules.expected \
    && diff -u /tmp/submodules.expected /tmp/submodules.actual \
    && cp /tmp/submodules.actual /workspace/vtr-submodules.txt

# ACE's pinned vector reader dereferences the failed EOF read when a normal
# newline-terminated trace is supplied.  Apply the reviewed compatibility
# patch before compilation, and verify both its identity and exact results.
RUN <<'ACE_PATCH_SCRIPT'
set -eu
cat > /tmp/ace_frozen_vectors.patch <<'ACE_PATCH'
--- a/vtr_flow/scripts/python_libs/vtr/ace/ace.py
+++ b/vtr_flow/scripts/python_libs/vtr/ace/ace.py
@@ -86,5 +86,7 @@
         "-s",
         str(ace_seed),
+        "-v",
+        "/inputs/active.vec",
     ]
 
     command_runner.run_system_command(
--- a/ace2/io_ace.c
+++ b/ace2/io_ace.c
@@ -304,13 +304,8 @@
 			int * toggles;
 			int * current;
 			char vector[ACE_CHAR_BUFFER_SIZE];
-            char* res;
 
-			res = fgets(line, ACE_CHAR_BUFFER_SIZE, in_file_desc);
-            VTR_ASSERT(res);
-			while (!feof(in_file_desc)) {
-				res = fgets(line, ACE_CHAR_BUFFER_SIZE, in_file_desc);
-                VTR_ASSERT(res);
+			while (fgets(line, ACE_CHAR_BUFFER_SIZE, in_file_desc)) {
 				num_vec++;
 			}
 			Abc_NtkForEachPi(ntk, obj_ptr, i)
@@ -326,9 +321,7 @@
 
 
 			num_vec = 0;
-			res = fgets(line, ACE_CHAR_BUFFER_SIZE, in_file_desc);
-            VTR_ASSERT(res);
-			while (!feof(in_file_desc)) {
+			while (fgets(line, ACE_CHAR_BUFFER_SIZE, in_file_desc)) {
 				sscanf(line, "%s\n", vector);
 
 				if (strlen(vector) != num_Pi) {
@@ -365,8 +358,6 @@
 					info->values[num_vec] = (vector[i] == '1');
 				}
 
-				res = fgets(line, ACE_CHAR_BUFFER_SIZE, in_file_desc);
-                VTR_ASSERT(res);
 				num_vec++;
 			}
 
ACE_PATCH
echo 'b6ca0e901a5d6eeb67f3de8c8afc69b54bf676b28addf3a270fffbd4ee3f86b7  /tmp/ace_frozen_vectors.patch' | sha256sum -c -
echo '9d751e3b61a43f0a8d1533d4c53f196e3fb9f165b1339313d9a7de0e66692029  vtr_flow/scripts/python_libs/vtr/ace/ace.py' | sha256sum -c -
echo '89dc8c27e3726dd460437dfee8387456386e284c7ec6391d598183a234c0dd88  ace2/io_ace.c' | sha256sum -c -
patch -p1 --silent < /tmp/ace_frozen_vectors.patch
echo '1ac020b62f0998ec9f1fd10cefb6f8107e20894c4a288e8233ec1dd8fe31482c  vtr_flow/scripts/python_libs/vtr/ace/ace.py' | sha256sum -c -
echo '58eee2eaa49ee8dce3d3b1131dc697608f203a9e960977d937c83e8ec197e6ff  ace2/io_ace.c' | sha256sum -c -
ACE_PATCH_SCRIPT

# Build only the headless components used by synthesis, formal, activity
# estimation and routed PPA measurement.  IPO is disabled for reliable amd64
# emulation on Apple Silicon.
RUN --mount=type=cache,id=rtl-sha-vtr-ppa45-95f5c6de-build,target=/workspace/build \
    if test -x build/vpr/vpr && test -x build/ace2/ace \
      && test -x build/yosys-obj/yosys && test -f build/share/yosys/plugins/parmys.so \
      && grep -qx 'b6ca0e901a5d6eeb67f3de8c8afc69b54bf676b28addf3a270fffbd4ee3f86b7' \
        build/.ace_frozen_vectors_patch.sha256; then \
      rm -rf build-image && cp -a build build-image && exit 0; \
    fi; \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=release \
      -DVPR_USE_EZGL=off \
      -DVTR_IPO_BUILD=off \
      -DVTR_ENABLE_CAPNPROTO=off \
      -DVPR_ENABLE_INTERCHANGE=off \
    && cmake --build build --target abc --parallel 2 \
    && mkdir -p build/yosys-obj \
    && if ! test -x build/yosys-obj/yosys; then make -C /workspace/libs/EXTERNAL/yosys ENABLE_ABC=0 clean; fi \
    && mkdir -p build/yosys-obj/techlibs/gatemate \
    && cd build/yosys-obj \
    && python3 /workspace/libs/EXTERNAL/yosys/techlibs/gatemate/make_lut_tree_lib.py \
    && touch techlibs/gatemate/lut_tree_lib.mk \
    && cd /workspace \
    && make -C build/yosys-obj -f /workspace/libs/EXTERNAL/yosys/Makefile \
      ENABLE_ABC=0 PREFIX=/workspace/build -j2 \
    && make -C build/yosys-obj -f /workspace/libs/EXTERNAL/yosys/Makefile \
      ENABLE_ABC=0 PREFIX=/workspace/build install \
    && mkdir -p /workspace/libs/EXTERNAL/yosys/share \
    && cp -a /workspace/build/share/yosys/include /workspace/libs/EXTERNAL/yosys/share/include \
    && cmake --build build --target parmys-plugin vpr ace --parallel 2 \
    && echo 'b6ca0e901a5d6eeb67f3de8c8afc69b54bf676b28addf3a270fffbd4ee3f86b7' \
      > build/.ace_frozen_vectors_patch.sha256 \
    && rm -rf build-image \
    && cp -a build build-image

# Pin the formal-equivalence and mutation-coverage front ends by source commit
# and archive digest.  MCY's optional GUI is deliberately not installed.
RUN rm -rf /workspace/build \
    && ln -s /workspace/build-image /workspace/build \
    && wget -q "https://github.com/YosysHQ/eqy/archive/${EQY_COMMIT}.tar.gz" -O /tmp/eqy.tar.gz \
    && echo "${EQY_ARCHIVE_SHA256}  /tmp/eqy.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/eqy.tar.gz -C /tmp \
    && echo "075125efb8a56c3c49f1fd6d5a16763516733e6366caff46fc89777b1fba6c66  /tmp/eqy-${EQY_COMMIT}/src/eqy_partition.cc" | sha256sum -c - \
    && sed -i 's/bool is_reg = c->is_builtin_ff();/bool is_reg = RTLIL::builtin_ff_cell_types().count(c->type);/' \
      "/tmp/eqy-${EQY_COMMIT}/src/eqy_partition.cc" \
    && echo "299f933b9706c90ad51a5d52eb3b9dbbb4421242d2ac73f2ac14c0d34e228644  /tmp/eqy-${EQY_COMMIT}/src/eqy_partition.cc" | sha256sum -c - \
    && make -C "/tmp/eqy-${EQY_COMMIT}" \
      PREFIX=/workspace/build YOSYS_CONFIG=/workspace/build/bin/yosys-config install \
    && wget -q "https://github.com/YosysHQ/mcy/archive/${MCY_COMMIT}.tar.gz" -O /tmp/mcy.tar.gz \
    && echo "${MCY_ARCHIVE_SHA256}  /tmp/mcy.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/mcy.tar.gz -C /tmp \
    && install -m 0755 "/tmp/mcy-${MCY_COMMIT}/mcy.py" /workspace/build/bin/mcy \
    && mkdir -p /workspace/build/share/mcy/scripts \
    && cp -a "/tmp/mcy-${MCY_COMMIT}/scripts/." /workspace/build/share/mcy/scripts/ \
    && cp /workspace/LICENSE.md /workspace/third-party-licenses/VTR-LICENSE.md \
    && cp /workspace/libs/EXTERNAL/yosys/COPYING /workspace/third-party-licenses/Yosys-COPYING \
    && cp /workspace/libs/EXTERNAL/yosys/abc/copyright.txt /workspace/third-party-licenses/ABC-copyright.txt \
    && cp "/tmp/eqy-${EQY_COMMIT}/COPYING" /workspace/third-party-licenses/EQY-COPYING \
    && cp "/tmp/mcy-${MCY_COMMIT}/COPYING" /workspace/third-party-licenses/MCY-COPYING \
    && find /workspace/third-party-licenses -maxdepth 1 -type f \
      ! -name license-manifest.sha256 -print0 \
      | LC_ALL=C sort -z | xargs -0 sha256sum > /workspace/third-party-licenses/license-manifest.sha256 \
    && rm -rf /tmp/eqy* /tmp/mcy*

# The BuildKit cache is not part of the image layer.  Capture the completed
# Linux build, then replace any host-native build copied with the VTR checkout.
RUN rm -rf build && mv build-image build \
    && echo '33da7b62c7eecbb4b567186848f30278be7f3f59a7282baca54887b6c4fdaab7  requirements-ppa45-linux-amd64.lock' | sha256sum -c - \
    && build/bin/yosys -V \
    && build/bin/eqy --version \
    && build/bin/mcy --help >/dev/null \
    && test -x build/ace2/ace \
    && test -x build/vpr/vpr

ENV PATH=/workspace/build/bin:/workspace/build/vpr:/workspace/build/ace2:${PATH}
SHELL ["/bin/bash", "-c"]
