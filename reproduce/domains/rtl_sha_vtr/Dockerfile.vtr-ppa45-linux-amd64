ENV WORKSPACE=/workspace
WORKDIR ${WORKSPACE}
COPY . ${WORKSPACE}

# A dated Ubuntu snapshot prevents package drift between image rebuilds.  The
# HTTPS-bootstrap packages are exact-versioned; the remaining explicitly
# headless package set resolves only against the immutable snapshot.
RUN apt-get update -qq \
    && apt-get -y install --no-install-recommends \
      ca-certificates=20240203 openssl=3.0.13-0ubuntu3.11 \
    && sed -i "s|http://archive.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/|g; \
            s|http://security.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/|g" \
      /etc/apt/sources.list.d/ubuntu.sources \
    && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot \
    && apt-get update -qq \
    && apt-get -y install --no-install-recommends \
      bison build-essential clang cmake flex gawk git libboost-filesystem-dev \
      libboost-python-dev libboost-system-dev libeigen3-dev libffi-dev \
      libreadline-dev libtbb-dev libxml2-utils make ninja-build patch pkg-config \
      python3-click python3-dev python3-pip python3-venv swig tcl-dev time \
      verilator wget zlib1g-dev \
    && python3 -m venv ${WORKSPACE}/.venv \
    && printf '%s\n' \
